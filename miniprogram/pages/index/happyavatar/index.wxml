
  <van-nav-bar
    title="开心头像"
    left-text="返回"
    left-arrow
    bind:click-left="onClickLeft"
  />
  <view class="container">
    <swiper id="avatarSwiper" 
    circular
      bindchange="onSwiperChange"
      current="swiperCurrentIndex">
      <swiper-item wx:for="{{avatarInfoList}}" wx:key="title">
          <text>《{{item.title}}》</text>
          <image mode="widthFix" src="{{item.src}}" bind:longpress="onSaveImage"
          bindloadstart="onImageLoadStart"
          bindload="onImageLoad"
          binderror="onImageLoadError"
          ></image>
      </swiper-item>
    </swiper>
    <view class="btn-group">
      <van-button type="primary" bind:tap="downloadImage">刷新</van-button>
      <van-button type="primary" bind:tap="saveImageToAlbum">保存</van-button>
    </view>
  </view>

<view class="ad-container">
  <ad 
    unit-id="adunit-619699d3ad5bccd0"  
    type="banner"
    size="banner"
    bindload="onAdLoad"
    binderror="onAdError"
    bindclose="onAdClose"      
  ></ad>
</view>